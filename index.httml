<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
'use strict';
const API='https://egx-smart.mhmedzaki3.workers.dev';
const stocks=[{ticker:'COMI',ar:'????? ??????? ??????',en:'Commercial International Bank'},{ticker:'TMGH',ar:'???? ?????',en:'Talaat Moustafa'},{ticker:'ETEL',ar:'??????? ?????????',en:'Telecom Egypt'},{ticker:'SWDY',ar:'???????',en:'Elsewedy Electric'},{ticker:'ABUK',ar:'??? ??? ???????',en:'Abu Qir Fertilizers'},{ticker:'EFIH',ar:'?? ???????',en:'e-Finance'},{ticker:'HRHO',ar:'??????',en:'EFG Hermes'},{ticker:'MFPC',ar:'?????',en:'MOPCO'},{ticker:'SKPC',ar:'???? ????',en:'SIDPEC'},{ticker:'ESRS',ar:'???? ??',en:'Ezz Steel'},{ticker:'ORAS',ar:'????????',en:'Orascom Construction'},{ticker:'PHDC',ar:'???? ????',en:'Palm Hills'},{ticker:'JUFO',ar:'?????',en:'Juhayna'},{ticker:'AMOC',ar:'????',en:'AMOC'},{ticker:'FWRY',ar:'????',en:'Fawry'}];
const el=id=>document.getElementById(id);const money=v=>new Intl.NumberFormat(lang==='ar'?'ar-EG':'en-US',{minimumFractionDigits:2,maximumFractionDigits:2}).format(Number(v)||0)+(lang==='ar'?' ?.?':' EGP');
let lang='ar',currentTab='market',previousTab='market',portfolio=[],myChart=null,currentPrices={},loadingPrices=false,loadingChart=false,userRole='intermediate';
try{portfolio=JSON.parse(localStorage.getItem('st_portfolio')||'[]');if(!Array.isArray(portfolio))portfolio=[];portfolio=portfolio.filter(p=>p&&stocks.some(s=>s.ticker===p.ticker)&&Number(p.qty)>0&&Number(p.buy)>0).map(p=>({ticker:p.ticker,qty:Number(p.qty),buy:Number(p.buy),current:Number(p.current)>0?Number(p.current):null}));}catch(_){portfolio=[];}
function stockName(s){return lang==='ar'?s.ar:s.en}function setStatus(id,msg,type=''){const node=el(id);node.textContent=msg;node.className='status'+(type?' '+type:'');}
function safeStore(key,value){try{localStorage.setItem(key,value);return true}catch(_){return false}}
function populateSelects(){const html=stocks.map(s=>`<option value="${s.ticker}">${stockName(s)} (${s.ticker})</option>`).join('');el('chartStockSelect').innerHTML=html;el('pStock').innerHTML=html;}
function applyUserRole(){el('aiAnalyzeBtn').classList.remove('hidden');}
function showApp(){el('loginScreen').style.display='none';el('appScreen').classList.add('active');el('displayName').textContent='???? ??? ????';el('avatarChar').textContent='ST';populateSelects();applyUserRole();renderPortfolio();switchTab('market',false);}
function login(){const name=el('userName').value.trim()||'????????';userRole=['beginner','intermediate','pro'].includes(el('userLevel').value)?el('userLevel').value:'intermediate';safeStore('st_name',name);safeStore('st_role',userRole);showApp();}
function switchTab(tab,push=true){if(!['market','charts','portfolio'].includes(tab))return;if(tab!==currentTab)previousTab=currentTab;currentTab=tab;document.querySelectorAll('.nav-btn').forEach(b=>b.classList.toggle('active',b.dataset.tab===tab));['market','charts','portfolio'].forEach(t=>el(t+'Page').classList.toggle('hidden',t!==tab));if(push){try{history.pushState({stTab:tab},'',location.pathname+location.search+'#'+tab)}catch(_){}}if(tab==='charts'&&!loadingChart)loadChart();if(tab==='portfolio')renderPortfolio();}
function goBack(){if(el('exitScreen').classList.contains('active')){el('exitScreen').classList.remove('active');return}if(currentTab!=='market'){switchTab(previousTab);return}el('exitScreen').classList.add('active');}
window.addEventListener('popstate',e=>{if(e.state&&e.state.stTab)switchTab(e.state.stTab,false);else if(currentTab!=='market')switchTab('market',false);else el('exitScreen').classList.add('active')});document.addEventListener('keydown',e=>{if(e.key==='Escape'){if(!el('exitScreen').classList.contains('active'))goBack();else el('exitScreen').classList.remove('active')}});
function applyTheme(theme){const t=theme==='dark'?'dark':'light';el('htmlTag').dataset.theme=t;el('themeBtn').textContent=t==='dark'?'??':'??';el('themeBtn').title=t==='dark'?'??????? ??? ????? ??????':'??????? ??? ????? ??????';try{localStorage.setItem('st_theme',t)}catch(_){}if(myChart&&myChart.options&&myChart.options.scales){const fg=t==='dark'?'#e8eef8':'#64748b',grid=t==='dark'?'#263750':'#e2e8f0';for(const axis of Object.values(myChart.options.scales)){if(axis.ticks)axis.ticks.color=fg;if(axis.grid)axis.grid.color=grid}myChart.update('none')}}
function toggleTheme(){applyTheme(el('htmlTag').dataset.theme==='dark'?'light':'dark')}
function validBars(data){if(!data||data.ok!==true||!Array.isArray(data.bars))return[];return data.bars.filter(b=>b&&Number.isFinite(Number(b.close))&&b.date).sort((a,b)=>new Date(a.date)-new Date(b.date));}
async function fetchOne(s){try{const res=await fetch(`${API}/api/public/yahoo?symbol=${encodeURIComponent(s.ticker)}.CA&range=1mo`,{headers:{Accept:'application/json'}});if(!res.ok)throw Error('HTTP '+res.status);return{stock:s,data:await res.json()}}catch(_){return{stock:s,data:null}}}
async function fetchPrices(){if(loadingPrices)return;loadingPrices=true;el('fetchBtn').disabled=true;el('loader').classList.remove('hidden');setStatus('marketStatus','???? ????? ???????...');try{const results=await Promise.all(stocks.map(fetchOne));let success=0;el('marketList').replaceChildren();results.forEach(r=>{const bars=validBars(r.data),row=document.createElement('div');row.className='stock-item';const info=document.createElement('div');info.className='stock-info';const title=document.createElement('h4');title.textContent=stockName(r.stock);const ticker=document.createElement('p');ticker.textContent=r.stock.ticker+'.CA';info.append(title,ticker);const price=document.createElement('div');if(bars.length){const value=Number(bars[bars.length-1].close);currentPrices[r.stock.ticker]=value;success++;price.className='stock-price';price.textContent=money(value)}else{price.className='stock-price error';price.textContent='??? ????'}row.append(info,price);el('marketList').append(row)});if(success===stocks.length)setStatus('marketStatus',`?? ????? ?????? ${success} ????? ?????.`,'success');else if(success)setStatus('marketStatus',`????? ?????? ${success} ?? ${stocks.length} ????? ???? ?? ???? ??? ??????? ??? ?????.`,'error');else setStatus('marketStatus','???? ??? ???????. ???? ?? ??????? ?? ???? ???????? ?? ???? ??????.','error');renderPortfolio()}finally{loadingPrices=false;el('fetchBtn').disabled=false;el('loader').classList.add('hidden')}}
async function loadChart(){if(loadingChart)return;const ticker=el('chartStockSelect').value||'COMI',range=el('chartRangeSelect').value;loadingChart=true;el('loadChartBtn').disabled=true;setStatus('chartStatus','???? ????? ?????...');try{const res=await fetch(`${API}/api/public/yahoo?symbol=${encodeURIComponent(ticker)}.CA&range=${encodeURIComponent(range)}`,{headers:{Accept:'application/json'}});if(!res.ok)throw Error('HTTP '+res.status);const data=await res.json(),bars=validBars(data);if(!bars.length)throw Error('No chart data');if(typeof Chart==='undefined')throw Error('Chart.js unavailable');const canvas=el('stockChart');if(myChart){myChart.destroy();myChart=null}myChart=new Chart(canvas,{type:'line',data:{labels:bars.map(b=>new Date(b.date).toLocaleDateString(lang==='ar'?'ar-EG':'en-GB',{month:'short',day:'numeric'})),datasets:[{label:ticker,data:bars.map(b=>Number(b.close)),borderColor:'#2563eb',backgroundColor:'rgba(37,99,235,.1)',fill:true,borderWidth:2.5,pointRadius:0,tension:.25}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{x:{ticks:{maxTicksLimit:6},grid:{display:false}},y:{grid:{color:'#e2e8f0'}}}}});setStatus('chartStatus',`?? ????? ${bars.length} ???? ????? ????? ${ticker}.`,'success')}catch(_){if(myChart){myChart.destroy();myChart=null}setStatus('chartStatus','???? ????? ????? ?? ????? ??????. ???? ?? ???????? ?????? ?????? ?????.','error')}finally{loadingChart=false;el('loadChartBtn').disabled=false}}
function renderPortfolio(){
 let totalCost=0,totalMarket=0,totalPnl=0,totalQty=0;el('portfolioList').replaceChildren();
 portfolio.forEach((p,index)=>{const stock=stocks.find(s=>s.ticker===p.ticker);if(!stock)return;const live=Number(currentPrices[p.ticker]);const hasLive=Number.isFinite(live)&&live>0;const price=hasLive?live:(Number(p.current)>0?Number(p.current):p.buy);const value=p.qty*price,cost=p.qty*p.buy,pnl=value-cost,pct=cost?pnl/cost*100:0;totalCost+=cost;totalMarket+=value;totalPnl+=pnl;totalQty+=p.qty;
 const row=document.createElement('div');row.className='stock-item';row.style.alignItems='flex-start';const info=document.createElement('div');info.className='stock-info';const name=document.createElement('h4');name.textContent=stockName(stock)+' ('+stock.ticker+')';const details=document.createElement('p');details.textContent=`??????: ${p.qty} ??? | ????: ${money(p.buy)} | ??????: ${money(price)}`;const totals=document.createElement('p');totals.style.marginTop='5px';totals.textContent=`???????: ${money(cost)} | ?????? ???????: ${money(value)}`;const source=document.createElement('p');source.textContent=hasLive?'????? ??????: ??? ??? ?? ???? ?? ???? ????????':(Number(p.current)>0?'????? ??????: ????? ??????':'????? ?????? ?????? = ??? ??????? ???? ????? ???????');info.append(name,details,totals,source);
 const right=document.createElement('div');right.style.textAlign='left';right.style.minWidth='105px';const pnlEl=document.createElement('div');pnlEl.className='stock-price';pnlEl.style.color=pnl>=0?'var(--accent)':'var(--danger)';pnlEl.textContent=(pnl>0?'+':'')+money(pnl);const pctEl=document.createElement('div');pctEl.style.fontSize='12px';pctEl.style.fontWeight='800';pctEl.style.color=pnl>=0?'var(--accent)':'var(--danger)';pctEl.textContent=(pct>0?'+':'')+pct.toFixed(2)+'%';right.append(pnlEl,pctEl);
 const edit=document.createElement('input');edit.type='number';edit.min='0.01';edit.step='0.01';edit.placeholder='????? ?????';edit.value=Number(p.current)>0&&!hasLive?p.current:'';edit.className='custom-input';edit.style.width='108px';edit.style.marginTop='8px';edit.style.marginBottom='5px';edit.setAttribute('aria-label','????? ????? ?????? '+p.ticker);const update=document.createElement('button');update.className='small-button';update.style.padding='5px 7px';update.textContent='??? ?????';update.onclick=()=>{const v=Number(edit.value);if(!Number.isFinite(v)||v<=0){setStatus('portfolioStatus','???? ????? ?????? ?????? ???? ?? ???.','error');return}p.current=v;if(!safeStore('st_portfolio',JSON.stringify(portfolio))){setStatus('portfolioStatus','???? ??? ????? ??? ??? ??????.','error');return}renderPortfolio();setStatus('portfolioStatus','?? ????? ????? ?????? ??????.','success')};right.append(edit,update);
 const remove=document.createElement('button');remove.className='small-button';remove.style.padding='5px 7px';remove.style.marginTop='5px';remove.textContent='??? ?????';remove.onclick=()=>{if(!confirm('?? ???? ??? '+p.ticker+' ?? ????????'))return;portfolio.splice(index,1);safeStore('st_portfolio',JSON.stringify(portfolio));renderPortfolio()};right.append(remove);row.append(info,right);el('portfolioList').append(row);
 });
 const pct=totalCost?totalPnl/totalCost*100:0;el('totalCostVal').textContent=money(totalCost);el('totalMarketVal').textContent=money(totalMarket);el('totalQtyVal').textContent=new Intl.NumberFormat(lang==='ar'?'ar-EG':'en-US').format(totalQty);el('totalPnlVal').textContent=(totalPnl>0?'+':'')+money(totalPnl);el('totalPnlPct').textContent=(pct>0?'+':'')+pct.toFixed(2)+'% ?? ????? ??????';el('totalPnlVal').style.color=totalPnl>=0?'var(--accent)':'var(--danger)';el('totalPnlPct').style.color=pct>=0?'var(--accent)':'var(--danger)';
 if(!portfolio.length)el('portfolioList').innerHTML='<p class="note">?? ???? ???? ?? ??????? ???. ???? ????? ?? ??????? ???? ?????? ??????.</p>';
 setStatus('portfolioStatus',Object.keys(currentPrices).length?'??????? ?????? ??? ??????? ???? ??? ?????. ????? ?????? ??????? ??? ????? ?? ????? ??? ??? ???? ???? ?????.':'?? ??? ??? ????? ????? ???. ?????? ???? ?? ???? ????? ?????? ?????? ?????? ???? ??????? ???? ?? ???? ?????/??????? ??????? ?????? ??????.');
}
function addPortfolio(){const ticker=el('pStock').value,qty=Number(el('pQty').value),buy=Number(el('pBuy').value),currentRaw=el('pCurrent').value.trim(),current=currentRaw===''?null:Number(currentRaw);if(!stocks.some(s=>s.ticker===ticker)||!Number.isInteger(qty)||qty<=0||!Number.isFinite(buy)||buy<=0||(current!==null&&(!Number.isFinite(current)||current<=0))){setStatus('portfolioStatus','???? ????????: ?????? ??? ???? ???? ?? ???? ???? ?????? ?????? ?????? ????????? ???? ?? ???.','error');return}portfolio.push({ticker,qty,buy,current});if(!safeStore('st_portfolio',JSON.stringify(portfolio))){portfolio.pop();setStatus('portfolioStatus','???? ??? ??????? ??? ??? ??????.','error');return}el('pQty').value='100';el('pCurrent').value='';setStatus('portfolioStatus','??? ????? ????? ???? ??????? ??? ??? ??????.','success');renderPortfolio()}
function sma(values,period){if(values.length<period)return null;return values.slice(-period).reduce((a,b)=>a+b,0)/period}
async function analyzeSelectedStock(){
 const ticker=el('chartStockSelect').value||'COMI',out=el('finalRecommendation'),marketOut=el('aiResult');
 out.textContent='???? ????? ??????? ?????? ???? ?????? ???????...';
 if(marketOut){marketOut.classList.remove('hidden');marketOut.textContent='???? ???? ???????? ?? ???????? ???????...'}
 try{
  const res=await fetch(`${API}/api/public/yahoo?symbol=${encodeURIComponent(ticker)}.CA&range=6mo`,{headers:{Accept:'application/json'}});
  if(!res.ok)throw Error('???? ??????? ??? ????');
  const bars=validBars(await res.json()),prices=bars.map(b=>Number(b.close)).filter(Number.isFinite);
  if(prices.length<50)throw Error('?????? ??????? ??? ?????');
  const last=prices.at(-1),ma20=sma(prices,20),ma50=sma(prices,50),delta=(ma20-ma50)/ma50*100;
  const recent=prices.slice(-20),low20=Math.min(...recent),high20=Math.max(...recent),held=portfolio.some(x=>x.ticker===ticker);
  let heading,details,trigger,stop,target;
  if(last>ma20&&ma20>ma50&&delta>1){
   heading='?? ???? ?????';trigger=`?????? ??? ????? ???? ????? ???? ?? ${money(ma20)}? ?????? ????? ?????? ???? ????? ?????.`;
   stop=low20;const risk=last-stop;target=risk>0?last+2*risk:null;
   details=`??????? ?????? ??? ?????????: ????? 20 ???? ???? ?? ????? 50 ????? ?????? ???? ?? ????? 20 ????. ?? ????? ????? ??? ????? ?????? ?? ???? ??????.`;
  }else if(last<ma20&&ma20<ma50&&delta< -1){
   heading=held?'?? ??? / ????? ??????':'?? ????? ?????? ??????';
   trigger=held?'???? ????? ?????? ?? ?????? ??? ??? ???????? ?? ????? ??? ??????? ?????.':'?? ???? ???? ???? ????? ?????? ??? ??? ???????? ????? ???? ???????.';
   stop=null;target=null;
   details=`??????? ????: ????? ???? ?? ????? 20 ???? ?????? 20 ???? ?? ????? 50 ????. ${held?'??? ????? ?????? ?????? ?????? ????? ??? ??? ????????.':'?? ???? ??? ????? ?? ??????? ??? ????? ??????.'}`;
  }else{
   heading='?? ?????? ??? ????? ???????';
   const conditions=[];
   if(last<=ma20)conditions.push(`????? ???? ?? ????? 20 ???? (${money(ma20)})`);
   if(ma20<=ma50)conditions.push(`???? ????? 20 ???? ????????/?????? ????? 50 ???? (${money(ma50)})`);
   if(!conditions.length)conditions.push('?????? ??? ????? ?? ????? ?? ??? ???????');
   trigger='????? ??? ?????: '+conditions.join('? ')+'? ?? ??? ???????.';
   stop=null;target=null;
   details='???????? ??????? ??? ??????? ??? ???? ?????? ???? ???? ?? ??? ????? ???????? ??? ???? ?? ?????? ?????.';
  }
  let report=`??????? ????????: ${heading}\n?????: ${ticker}\n??? ????? ????: ${money(last)}\n????? 20 ????: ${money(ma20)}\n????? 50 ????: ${money(ma50)}\n\n????????: ${details}\n????? / ???????: ${trigger}`;
  if(heading.includes('????')) report+=`\n??? ??????? ???????: ${money(stop)} (???? ??? ????? ??? ??? 20 ????? ??? ?? ????? ?? ??????????).\n????? ??????? ??????: ${target!==null?money(target):'??? ????'} (????? ????? ????/?????? 2:1? ???? ?????? ???????).`;
  report+=`\n\n?????: ??????? ???? ??? ?????? ??????? ??????? ??????? 20/50 ???? ???? ???????? ?????? ????? ??? ???? ?????? ?????. ????? ?? ????? ???????? ???????? ???????? ????????? ??? ???????.`;
  out.textContent=report;if(marketOut)marketOut.textContent=report;
 }catch(err){const msg='?? ???? ????? ?????? ??????: '+(err.message==='?????? ??????? ??? ?????'?'???????? ????????? ??????? ??? ?? 50 ????.':'???? ??????? ????? ??????? ?? ?? ????? ?????? ?????.');out.textContent=msg+' ?? ???? ????? ???? ?? ??? ??????? ??? ?????? ?????.';if(marketOut)marketOut.textContent=msg}
}
function toggleLang(){lang=lang==='ar'?'en':'ar';el('htmlTag').lang=lang;el('htmlTag').dir=lang==='ar'?'rtl':'ltr';el('langBtn').textContent=lang==='ar'?'EN':'????';document.querySelectorAll('[data-ar][data-en]').forEach(n=>n.textContent=n.dataset[lang]);document.querySelectorAll('.nav-btn').forEach((n,i)=>{const ar=['?????','???????','???????'],en=['Market','Analysis','Portfolio'];n.lastChild.textContent=lang==='ar'?ar[i]:en[i]});populateSelects();renderPortfolio();if(el('marketList').children.length)fetchPrices();if(currentTab==='charts')loadChart()}
function init(){let savedTheme='light';try{savedTheme=localStorage.getItem('st_theme')||'light'}catch(_){}applyTheme(savedTheme);const splash=el('splashScreen');setTimeout(()=>{splash.style.opacity='0';setTimeout(()=>{splash.style.display='none';let savedName='',savedRole='intermediate';try{savedName=localStorage.getItem('st_name')||'';savedRole=localStorage.getItem('st_role')||'intermediate'}catch(_){}if(savedName){userRole=['beginner','intermediate','pro'].includes(savedRole)?savedRole:'intermediate';el('userName').value=savedName;el('userLevel').value=userRole;showApp()}else{el('loginScreen').classList.remove('hidden-login')}},420)},1000)}
el('loginBtn').addEventListener('click',login);el('userName').addEventListener('keydown',e=>{if(e.key==='Enter')login()});el('fetchBtn').addEventListener('click',fetchPrices);el('loadChartBtn').addEventListener('click',loadChart);el('chartStockSelect').addEventListener('change',()=>{if(currentTab==='charts')loadChart()});el('chartRangeSelect').addEventListener('change',()=>{if(currentTab==='charts')loadChart()});el('addPortfolioBtn').addEventListener('click',addPortfolio);el('aiAnalyzeBtn').addEventListener('click',analyzeSelectedStock);el('finalAnalyzeBtn').addEventListener('click',analyzeSelectedStock);el('themeBtn').addEventListener('click',toggleTheme);el('langBtn').addEventListener('click',toggleLang);el('backBtn').addEventListener('click',goBack);document.querySelectorAll('.nav-btn').forEach(b=>b.addEventListener('click',()=>switchTab(b.dataset.tab)));document.querySelectorAll('[data-back]').forEach(b=>b.addEventListener('click',goBack));el('logoutBtn').addEventListener('click',()=>el('exitScreen').classList.add('active'));el('cancelExitBtn').addEventListener('click',()=>el('exitScreen').classList.remove('active'));el('confirmExitBtn').addEventListener('click',()=>{try{localStorage.removeItem('st_name')}catch(_){}location.reload()});init();
</script>
</body>
