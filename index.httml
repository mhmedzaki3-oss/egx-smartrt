<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap" rel="stylesheet">
<style>
:root{--primary:#2563eb;--primary-light:#eff6ff;--accent:#10b981;--danger:#ef4444;--bg:#f1f5f9;--surface:#fff;--text:#0f172a;--muted:#64748b;--border:#e2e8f0;--radius:22px;--shadow:0 4px 20px #0000000d;--card:#fff;--header-bg:#ffffffed;--input-bg:#f1f5f9;--soft-purple:#faf5ff}
html[data-theme="dark"]{--bg:#0b1220;--surface:#111c2e;--text:#e8eef8;--muted:#9eb0c9;--border:#263750;--primary-light:#173554;--card:#111c2e;--header-bg:#0b1220ed;--input-bg:#16243a;--soft-purple:#241d35;--shadow:0 4px 20px #00000035}
html[data-theme="dark"] body{background:var(--bg);color:var(--text)}html[data-theme="dark"] header,html[data-theme="dark"] .bottom-nav{background:var(--header-bg)}html[data-theme="dark"] .card,html[data-theme="dark"] .btn-icon,html[data-theme="dark"] .back-button,html[data-theme="dark"] .small-button{background:var(--card);color:var(--text);border-color:var(--border)}html[data-theme="dark"] .custom-select,html[data-theme="dark"] .custom-input,html[data-theme="dark"] .field input,html[data-theme="dark"] .field select{background:var(--input-bg);color:var(--text);border-color:var(--border)}html[data-theme="dark"] .ai-result{background:var(--soft-purple);color:var(--text)}html[data-theme="dark"] #loginScreen,html[data-theme="dark"] .exit-overlay{background:var(--bg);color:var(--text)}html[data-theme="dark"] .summary-box,html[data-theme="dark"] #addPortfolioSection{background:var(--input-bg)!important}html[data-theme="dark"] .btn-market{background:var(--primary-light)}html[data-theme="dark"] .btn-ai{background:var(--soft-purple)}
*{box-sizing:border-box;margin:0;padding:0;font-family:'Cairo',sans-serif;-webkit-tap-highlight-color:transparent}body{background:var(--bg);color:var(--text);overflow-x:hidden}button,input,select{font:inherit}button{cursor:pointer}button:disabled{opacity:.55;cursor:wait}.hidden{display:none!important}
#splashScreen{position:fixed;inset:0;z-index:9999;background:white;display:flex;flex-direction:column;align-items:center;justify-content:center;transition:opacity .4s}.splash-logo{width:90px;height:90px;border-radius:26px;background:linear-gradient(135deg,var(--primary),var(--accent));display:grid;place-items:center;color:#fff;font-size:38px;font-weight:900;box-shadow:0 10px 30px #2563eb33}.splash-text{font-size:22px;font-weight:900;margin-top:18px}.splash-subtext{font-size:13px;color:var(--muted);margin-top:5px}
#loginScreen{position:fixed;inset:0;z-index:1000;background:var(--surface);display:flex;flex-direction:column;overflow:auto;padding:28px 20px;transition:transform .35s}.hidden-login{transform:translateY(110%);pointer-events:none}.login-header{text-align:center;margin:35px 0 28px}.login-header h1{font-size:26px;font-weight:900}.login-header p{font-size:14px;color:var(--muted);margin-top:8px}.field{margin-bottom:18px}.field label{display:block;font-size:13px;color:var(--muted);margin-bottom:7px}.field input,.field select{width:100%;padding:14px;border:1.5px solid var(--border);border-radius:14px;background:var(--bg);font-size:15px;color:var(--text)}.field input:focus,.field select:focus{outline:2px solid #bfdbfe;border-color:var(--primary)}
.btn-primary{width:100%;padding:15px;border:0;border-radius:15px;background:var(--primary);color:white;font-weight:700;box-shadow:0 7px 18px #2563eb2b}.btn-primary:active,.btn-action:active,.btn-icon:active{transform:scale(.98)}#appScreen{display:none;min-height:100vh;padding-bottom:92px}#appScreen.active{display:block;animation:fadeIn .3s}@keyframes fadeIn{from{opacity:0;transform:translateY(7px)}to{opacity:1;transform:translateY(0)}}header{position:sticky;top:0;z-index:100;background:var(--header-bg);backdrop-filter:blur(10px);padding:14px 16px;border-radius:0 0 25px 25px;box-shadow:0 2px 10px #00000008;display:flex;justify-content:space-between;align-items:center;gap:8px}.user-info{display:flex;align-items:center;gap:10px;min-width:0}.avatar{width:42px;height:42px;flex-shrink:0;background:var(--primary-light);color:var(--primary);border-radius:50%;display:grid;place-items:center;font-weight:900}.user-text h2{font-size:12px;color:var(--muted)}.user-text h1{font-size:16px;font-weight:900;overflow-wrap:anywhere}.header-actions{display:flex;gap:7px}.btn-icon{min-width:39px;height:39px;padding:0 9px;border:1px solid var(--border);background:var(--card);border-radius:12px;font-size:17px;color:var(--text)}main{padding:18px;max-width:650px;margin:auto}.section-title{font-size:18px;font-weight:900;margin-bottom:14px}.card{background:var(--card);border-radius:var(--radius);padding:17px;margin-bottom:18px;box-shadow:var(--shadow)}.action-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:17px}.btn-action{padding:14px 8px;border:0;border-radius:18px;font-size:14px;font-weight:700;display:flex;flex-direction:column;align-items:center;gap:6px}.btn-action span{font-size:23px}.btn-market{background:var(--primary-light);color:var(--primary)}.btn-ai{background:#faf5ff;color:#9333ea}.stock-item{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:13px 0;border-bottom:1px solid var(--border)}.stock-item:last-child{border-bottom:0}.stock-info{min-width:0}.stock-info h4{font-size:14px;font-weight:700}.stock-info p{font-size:11px;color:var(--muted);margin-top:3px}.stock-price{font-size:14px;font-weight:900;color:var(--primary);text-align:left;white-space:nowrap}.stock-price.error{font-size:12px;color:var(--danger)}.status{font-size:12px;color:var(--muted);margin-bottom:9px;line-height:1.7}.status.error{color:var(--danger)}.status.success{color:#059669}.bottom-nav{position:fixed;bottom:0;left:0;right:0;background:#ffffffed;backdrop-filter:blur(10px);display:flex;justify-content:space-around;padding:8px 8px calc(8px + env(safe-area-inset-bottom));border-top:1px solid var(--border);z-index:200}.nav-btn{display:flex;flex-direction:column;align-items:center;gap:3px;background:none;border:0;color:var(--muted);font-size:11px;font-weight:700;padding:6px 14px;border-radius:12px}.nav-btn.active{color:var(--primary);background:var(--primary-light)}.nav-btn span{font-size:21px}.custom-select,.custom-input{width:100%;padding:11px;border-radius:12px;border:1px solid var(--border);background:var(--bg);font-weight:600;margin-bottom:10px;color:var(--text)}.chart-container{position:relative;height:270px;width:100%;margin-top:12px}.portfolio-summary{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-bottom:18px}.summary-box{background:var(--bg);padding:13px;border-radius:14px;min-width:0}.summary-box p{font-size:11px;color:var(--muted)}.summary-box h3{font-size:17px;font-weight:900;margin-top:5px;overflow-wrap:anywhere}.note{text-align:center;font-size:11px;color:var(--muted);line-height:1.8}.inline-actions{display:flex;gap:8px;margin-bottom:10px}.inline-actions button{flex:1}.back-button{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--border);border-radius:12px;background:white;padding:7px 11px;margin-bottom:12px;color:var(--text);font-size:12px}.exit-overlay{position:fixed;inset:0;z-index:5000;background:#ffffffed;backdrop-filter:blur(8px);display:none;align-items:center;justify-content:center;text-align:center;padding:20px}.exit-overlay.active{display:flex}.exit-box{max-width:320px}.exit-icon{font-size:54px}.exit-box h2{font-size:22px;margin:12px 0}.exit-box p{font-size:14px;color:var(--muted);margin-bottom:20px}.exit-box button{margin-top:8px}.small-button{border:1px solid var(--border);background:var(--card);color:var(--text);border-radius:12px;padding:12px;width:100%;font-weight:700}.ai-result{background:var(--soft-purple);border-radius:14px;padding:14px;font-size:13px;line-height:1.9;margin-top:12px}.footer-note{font-size:11px;color:var(--muted);text-align:center;margin-top:12px}
</style>
</head>
